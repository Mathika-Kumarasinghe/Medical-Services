@model IEnumerable<Member04_SharingAndCustomerAccess.Models.Notice>

@{
    ViewData["Title"] = "Medical Device Safety and Recall Notices";
    string selectedType = ViewBag.SelectedType ?? "All";
}

<div class="container mt-4">

    <h2>Medical Device Safety and Recall Notices</h2>

    <p class="text-muted">
        Review important medical device safety alerts and recall information.
    </p>

    <!-- Filter Buttons -->
    <div class="mb-4">

        <a asp-controller="Notice"
           asp-action="Index"
           asp-route-type="All"
           class="btn @(selectedType == "All" ? "btn-primary" : "btn-outline-primary")">
            All Notices
        </a>

        <a asp-controller="Notice"
           asp-action="Index"
           asp-route-type="Safety"
           class="btn @(selectedType == "Safety" ? "btn-primary" : "btn-outline-primary")">
            Safety Notices
        </a>

        <a asp-controller="Notice"
           asp-action="Index"
           asp-route-type="Recall"
           class="btn @(selectedType == "Recall" ? "btn-primary" : "btn-outline-primary")">
            Recall Notices
        </a>

    </div>

    <!-- Notice Cards -->
    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var notice in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5 class="card-title">
                                @notice.Title
                            </h5>

                            <p>
                                <strong>Device:</strong>
                                @notice.DeviceName
                            </p>

                            <p>@notice.Description</p>

                            <p>
                                <strong>Notice Type:</strong>
                                @notice.NoticeType
                            </p>

                            <p class="text-muted small">
                                Published:
                                @notice.PublishedDate.ToString("dd MMM yyyy")
                            </p>

                            <a asp-controller="Notice"
                               asp-action="Details"
                               asp-route-id="@notice.NoticeId"
                               class="btn btn-primary">
                                View Details
                            </a>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No notices found for this category.
        </div>
    }

    <a asp-controller="Customer"
       asp-action="Dashboard"
       class="btn btn-secondary mt-2">
        Back to Dashboard
    </a>

</div>
