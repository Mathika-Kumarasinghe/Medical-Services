@model IEnumerable<Member04_SharingAndCustomerAccess.Models.SharedFinding>

@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container mt-4">

    <!-- Dashboard Heading -->
    <div class="mb-3">
        <h2>Customer Dashboard</h2>

        <p class="text-muted">
            Risk findings shared with you are displayed below.
        </p>
    </div>

    <!-- Safety and Recall Notices Button -->
    <div class="mb-4">
        <a asp-controller="Notice"
           asp-action="Index"
           class="btn btn-success">
            View Safety and Recall Notices
        </a>
    </div>

    <!-- Shared Risk Findings -->
    <h4 class="mb-3">Shared Risk Findings</h4>

    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.Finding?.Title
                            </h5>

                            <p class="card-text">
                                @item.Finding?.Description
                            </p>

                            <p class="text-muted small">
                                <strong>Shared on:</strong>
                                @item.SharedDate.ToString("dd MMM yyyy")
                            </p>

                            <!-- View Finding Details -->
                            <a asp-controller="Customer"
                               asp-action="FindingDetails"
                               asp-route-id="@item.SharedFindingId"
                               class="btn btn-primary">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No risk findings have been shared with you yet.
        </div>
    }

</div>
